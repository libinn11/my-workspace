{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "declaration": true,
    "module": "es2022",  // Use es2022
    "moduleResolution": "bundler",  // Use bundler
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "exclude": ["src/**/*.spec.ts", "src/test-setup.ts"],
  "include": ["src/**/*.ts"]
}